class_name EncounterSpawner
extends RefCounted
## Turns encounter specs (generated by EncounterGenerator or written by hand) into nodes.

const BLOB_SCENE: PackedScene = preload("res://scenes/echo_blob.tscn")
const NEEDS := {
	"NOTE": EchoBlob.Need.NOTE, "SHY": EchoBlob.Need.SHY, "STIMULATED": EchoBlob.Need.STIMULATED,
	"GENTLE": EchoBlob.Need.GENTLE, "CAUTIOUS": EchoBlob.Need.CAUTIOUS, "WARMTH": EchoBlob.Need.WARMTH,
	"MELODY": EchoBlob.Need.MELODY, "PUSH": EchoBlob.Need.PUSH,
}


static func spawn(spec: Dictionary, parent: Node, geometry: WorldGeometry) -> Array[EchoBlob]:
	for obstacle in spec.get("obstacles", []):
		var center := Vector2(obstacle["pos"][0], obstacle["pos"][1])
		geometry.add_dynamic_obstacle(WorldGeometry.noisy_ellipse(center, obstacle["r"], obstacle["r"], 0.18, int(obstacle["seed"]), 16))
	var container: Node = parent
	var group: EchoBlobGroup = null
	if spec.get("group", "") != "":
		group = EchoBlobGroup.new()
		group.name = "Group_" + str(spec.get("id", "x")).replace(":", "_")
		match spec["group"]:
			"same_wave":
				group.mode = EchoBlobGroup.Mode.SAME_WAVE
			"cluster":
				group.mode = EchoBlobGroup.Mode.CLUSTER
			_:
				group.mode = EchoBlobGroup.Mode.TOGETHER
		container = group
	var blobs: Array[EchoBlob] = []
	for data in spec["blobs"]:
		var blob := make_blob(data, spec.get("area", ""))
		container.add_child(blob)
		blobs.append(blob)
	if group != null:
		parent.add_child(group)
	return blobs


static func make_blob(data: Dictionary, area: String) -> EchoBlob:
	var blob := BLOB_SCENE.instantiate() as EchoBlob
	blob.name = "Blob_" + str(data.get("id", "x")).replace(":", "_")
	blob.position = Vector2(data["pos"][0], data["pos"][1])
	blob.blob_id = str(data.get("id", ""))
	blob.area = area
	blob.note = int(data.get("note", 0))
	blob.need = NEEDS.get(str(data.get("need", "NOTE")), EchoBlob.Need.NOTE)
	blob.required_hits = int(data.get("hits", 1))
	blob.hidden_until_pinged = bool(data.get("hidden", false))
	blob.grey = bool(data.get("grey", false))
	blob.singer = bool(data.get("singer", false))
	if data.has("shy_silence"):
		blob.shy_silence = float(data["shy_silence"])
	if data.has("stim_window"):
		blob.stim_window = float(data["stim_window"])
	if data.has("warmth_duration"):
		blob.warmth_duration = float(data["warmth_duration"])
	if data.has("melody"):
		var melody := PackedInt32Array()
		for degree in data["melody"]:
			melody.append(int(degree))
		blob.melody = melody
	if data.has("nest"):
		blob.nest_position = Vector2(data["nest"][0], data["nest"][1])
	blob.anchored = bool(data.get("anchored", false))
	if data.has("radius"):
		blob.body_radius = float(data["radius"])
	return blob
